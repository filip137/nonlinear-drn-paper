{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/simulator/schema.json",
  "description": "Default simulator profile for a sampled custom/measured PWL I-V curve.",
  "non_linearity": "experimental",
  "voltage_amp": 4.0,
  "current_amp": 1.0,
  "iv_data_path": "data/assets/experimental_curve_voff_0.8_200_points.npz",
  "minimizer_impl": "custom",
  "mode": "asynchronous",
  "single_diode_updater": "custom",
  "double_diode_updater": "overrelaxed",
  "overrelaxation_factor": 1.0,
  "adaptive_equilibrium": false,
  "rel_tol": 1e-5,
  "vn_tol": 1e-6,
  "use_polish": false,
  "max_newton_iters": 32,
  "z_thresh": 1e10,
  "exp_clip": 100.0,
  "damping": 1.0,
  "experimental_newton_max_steps": 32,
  "experimental_newton_tol": 0.01
}
