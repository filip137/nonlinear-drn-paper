{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/simulator-v2.schema.json",
  "description": "Simulator profile preserving the paper MNIST double-Shockley settings.",
  "kind": "simulator_profile",
  "provenance": {
    "materialized_defaults": [
      "simulation.updater.asymptotic_terms",
      "simulation.updater.backend",
      "simulation.updater.linear_coefficient_clamp"
    ],
    "migration": {
      "from_schema_version": 1,
      "to_schema_version": 2,
      "tool": "scripts/migrate_training_configs.py"
    },
    "source": "Audited from configs/train/mnist_paper_double_shockley.json and data/paper/mnist/training_protocol.json."
  },
  "schema_version": 2,
  "simulation": {
    "amplification": {
      "current_factor": 1.0,
      "voltage_factor": 1.0
    },
    "nonlinearity": "double_diode_exponential",
    "physical": {
      "offset_voltage": 1.0,
      "saturation_current": 1e-06,
      "thermal_voltage": 0.05
    },
    "updater": {
      "asymptotic_terms": 4,
      "asymptotic_threshold": 10000000000.0,
      "backend": "torchlambertw",
      "dtype": "float64",
      "exponent_clip": 165.0,
      "linear_coefficient_clamp": 1000000.0,
      "method": "lambert_w_v1",
      "polish": false,
      "relaxation": 1.0
    }
  }
}
