{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/simulator/schema.json",
  "description": "Simulator profile preserving the paper MNIST double-Shockley settings.",
  "source": "Audited from configs/train/mnist_paper_double_shockley.json and data/paper/mnist/training_protocol.json.",
  "non_linearity": "double_diode_exponential",
  "voltage_amp": 1.0,
  "current_amp": 1.0,
  "exponential_diode_param": {"I_s": 1e-6, "V_t": 0.05, "V_off": 1.0},
  "minimizer_impl": "custom",
  "mode": "asynchronous",
  "single_diode_updater": "custom",
  "double_diode_updater": "float64",
  "overrelaxation_factor": 1.1,
  "adaptive_equilibrium": false,
  "rel_tol": 1e-5,
  "vn_tol": 1e-6,
  "use_polish": false,
  "max_newton_iters": 32,
  "z_thresh": 1e10,
  "exp_clip": 165.0,
  "damping": 0.5,
  "experimental_newton_max_steps": 100,
  "experimental_newton_tol": 1e-5
}
