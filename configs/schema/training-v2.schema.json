{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/training-v2.schema.json",
  "title": "Nonlinear DRN training configuration, version 2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/training-v2.schema.json"},
    "schema_version": {"const": 2},
    "kind": {"const": "training"},
    "description": {"type": "string", "minLength": 1},
    "data": {"$ref": "#/$defs/data"},
    "model": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/trainingModel"
    },
    "training": {"$ref": "#/$defs/training"},
    "equilibrium": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/fixedEquilibrium"
    },
    "simulation_ref": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/configReference"
    },
    "execution_ref": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/configReference"
    },
    "simulation": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/simulation"
    },
    "execution": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/execution"
    },
    "provenance": {
      "$ref": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/common-v2.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "description",
    "data",
    "model",
    "training",
    "equilibrium",
    "provenance"
  ],
  "oneOf": [
    {
      "title": "Strict composed training source",
      "required": ["simulation_ref", "execution_ref"],
      "not": {
        "anyOf": [
          {"required": ["simulation"]},
          {"required": ["execution"]}
        ]
      }
    },
    {
      "title": "Fully expanded executable training configuration",
      "required": ["simulation", "execution"],
      "not": {
        "anyOf": [
          {"required": ["simulation_ref"]},
          {"required": ["execution_ref"]}
        ]
      }
    }
  ],
  "$defs": {
    "digitsData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"const": "sklearn_digits"},
        "preprocessing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype": {"enum": ["float32", "float64"]},
            "method": {"const": "affine"},
            "divisor": {"type": "number", "exclusiveMinimum": 0},
            "multiplier": {"type": "number"},
            "offset": {"type": "number"}
          },
          "required": ["dtype", "method", "divisor", "multiplier", "offset"]
        },
        "subset": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {"method": {"const": "all"}},
              "required": ["method"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "method": {"const": "seeded_random"},
                "count": {"type": "integer", "minimum": 2, "maximum": 1797}
              },
              "required": ["method", "count"]
            }
          ]
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {"const": "seeded_random"},
            "train_fraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "rounding": {"const": "floor"}
          },
          "required": ["method", "train_fraction", "rounding"]
        },
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      },
      "required": ["source", "preprocessing", "subset", "split", "seed"]
    },
    "mnistData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"const": "torchvision_mnist"},
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(^/|^~|(^|/)\\.\\.(/|$))"}
        },
        "preprocessing": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dtype": {"enum": ["float32", "float64"]},
                "method": {"const": "to_tensor"}
              },
              "required": ["dtype", "method"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dtype": {"enum": ["float32", "float64"]},
                "method": {"const": "normalized_tensor"},
                "mean": {"type": "number"},
                "standard_deviation": {"type": "number", "exclusiveMinimum": 0},
                "scale": {"type": "number", "exclusiveMinimum": 0}
              },
              "required": ["dtype", "method", "mean", "standard_deviation", "scale"]
            }
          ]
        },
        "subset": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {"method": {"const": "all"}},
              "required": ["method"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "method": {"const": "prefix"},
                "train_count": {"type": "integer", "minimum": 1, "maximum": 60000},
                "evaluation_count": {"type": "integer", "minimum": 1, "maximum": 10000}
              },
              "required": ["method", "train_count", "evaluation_count"]
            }
          ]
        },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"method": {"const": "official"}},
          "required": ["method"]
        },
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      },
      "required": ["source", "path", "preprocessing", "subset", "split", "seed"]
    },
    "data": {
      "oneOf": [
        {"$ref": "#/$defs/digitsData"},
        {"$ref": "#/$defs/mnistData"}
      ]
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epochs": {"type": "integer", "minimum": 1},
        "batch_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "train": {"type": ["integer", "null"], "minimum": 1},
            "evaluation": {"type": ["integer", "null"], "minimum": 1}
          },
          "required": ["train", "evaluation"]
        },
        "loader": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "batch_size": {"type": "integer", "minimum": 1},
            "train_shuffle": {"type": "boolean"},
            "evaluation_shuffle": {"type": "boolean"},
            "drop_last": {"type": "boolean"}
          },
          "required": ["batch_size", "train_shuffle", "evaluation_shuffle", "drop_last"]
        },
        "equilibrium_propagation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "variant": {"enum": ["positive", "negative", "centered"]},
            "nudging": {"type": "number", "exclusiveMinimum": 0},
            "nudging_mode": {"const": "cost"},
            "gradient_formula": {"enum": ["standard", "alternative"]}
          },
          "required": ["variant", "nudging", "nudging_mode", "gradient_formula"]
        },
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {"const": "sgd"},
            "learning_rates": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number", "minimum": 0}
            },
            "momentum": {"type": "number", "minimum": 0},
            "dampening": {"const": 0.0},
            "weight_decay": {"type": "number", "minimum": 0},
            "zero_grad_set_to_none": {"type": "boolean"},
            "nesterov": {"const": false},
            "maximize": {"const": false},
            "foreach": {"const": false},
            "differentiable": {"const": false},
            "fused": {"const": false}
          },
          "required": [
            "method",
            "learning_rates",
            "momentum",
            "dampening",
            "weight_decay",
            "zero_grad_set_to_none",
            "nesterov",
            "maximize",
            "foreach",
            "differentiable",
            "fused"
          ]
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {"const": "exponential"},
            "gamma": {"type": "number", "exclusiveMinimum": 0},
            "step_timing": {"const": "after_epoch"},
            "initial_epoch": {"const": -1}
          },
          "required": ["method", "gamma", "step_timing", "initial_epoch"]
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "save_final": {"type": "boolean"},
            "save_best": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metric": {"const": "evaluation_accuracy"},
                "mode": {"const": "max"},
                "tie_break": {"const": "first"}
              },
              "required": ["metric", "mode", "tie_break"]
            }
          },
          "required": ["save_final", "save_best"]
        }
      },
      "required": [
        "epochs",
        "batch_limits",
        "loader",
        "equilibrium_propagation",
        "optimizer",
        "scheduler",
        "checkpoint"
      ]
    }
  }
}
