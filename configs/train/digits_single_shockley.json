{
  "description": "Compact sklearn Digits training configuration for the paper's single-Shockley nonlinearity.",
  "dataset": {
    "name": "digits",
    "num_samples": null,
    "train_fraction": 0.8
  },
  "layer_shapes": [[128], [32], [10]],
  "non_linearity": "single_diode_exponential",
  "weight_gains": [1.0, 1.0],
  "weight_min": 1e-7,
  "weight_max": 100.0,
  "weight_init_mode": "kaiming_uniform",
  "input_gain": 10.0,
  "voltage_amp": 4.0,
  "current_amp": 1.0,
  "quadratic_diode_param": {"diode_conductance": 1.0, "v_min": -0.5, "v_max": 0.5},
  "exponential_diode_param": {"I_s": 1e-6, "V_t": 0.05, "V_off": 0.8},
  "hard_sigmoid_param": {"g_on": 10.0, "g_off": 0.1, "v_min": -1.0, "v_max": 1.0},
  "batch_size": 32,
  "num_epochs": 15,
  "num_iterations": 32,
  "learning_rates": [0.01, 0.01, 0.01],
  "nudging": 1.0,
  "ep_variant": "centered",
  "minimizer_impl": "custom",
  "mode": "asynchronous",
  "single_diode_updater": "overrelaxed",
  "double_diode_updater": "float32_overrelaxed",
  "overrelaxation_factor": 1.2,
  "adaptive_equilibrium": false,
  "rel_tol": 1e-5,
  "vn_tol": 1e-6,
  "use_polish": true,
  "max_newton_iters": 8,
  "z_thresh": 1e10,
  "exp_clip": 165.0,
  "damping": 0.5,
  "experimental_newton_max_steps": 32,
  "experimental_newton_tol": 1e-5,
  "seed": 0
}
