{
  "description": "Paper MNIST DRN-XS configuration (double Shockley diode, centered equilibrium propagation).",
  "source": "paper_mnist_exp/config.used.json, model drn-xs",
  "dataset": {
    "name": "mnist",
    "root": "data/external/mnist",
    "normalize": true,
    "normalize_mean": 0.1307,
    "normalize_std": 0.3
  },
  "layer_shapes": [[2, 28, 28], [100], [20]],
  "non_linearity": "double_diode_exponential",
  "weight_gains": [1.0, 1.0],
  "weight_min": 1e-7,
  "weight_max": 100.0,
  "weight_init_mode": "kaiming_uniform",
  "input_gain": 50.0,
  "voltage_amp": 1.0,
  "current_amp": 1.0,
  "quadratic_diode_param": {"diode_conductance": 10.0, "v_min": -1.0, "v_max": 1.0},
  "exponential_diode_param": {"I_s": 1e-6, "V_t": 0.05, "V_off": 1.0},
  "hard_sigmoid_param": {"g_on": 10.0, "g_off": 10.0, "v_min": -1.0, "v_max": 1.0},
  "batch_size": 16,
  "num_epochs": 100,
  "num_iterations": 4,
  "learning_rates": [0.15, 0.15, 0.15],
  "nudging": 0.05,
  "ep_variant": "centered",
  "minimizer_impl": "custom",
  "mode": "asynchronous",
  "single_diode_updater": "custom",
  "double_diode_updater": "float64",
  "overrelaxation_factor": 1.0,
  "adaptive_equilibrium": true,
  "rel_tol": 1e-5,
  "vn_tol": 1e-6,
  "use_polish": true,
  "max_newton_iters": 32,
  "z_thresh": 1e10,
  "exp_clip": 100000.0,
  "damping": 0.5,
  "experimental_newton_max_steps": 100,
  "experimental_newton_tol": 1e-5,
  "seed": 0,
  "expected_results": {
    "test_error_percent": 3.46,
    "train_error_percent": 2.94,
    "reported_runtime": "about 30 minutes on the original host"
  }
}
