{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/train/schema.json",
  "description": "Paper MNIST accuracy-run protocol (DRN-XS, double Shockley diode, centered equilibrium propagation).",
  "source": "four selected paper_mnist_exp/voltage_amp1_current_amp1 runs; see data/paper/mnist/training_protocol.json",
  "dataset": {
    "name": "mnist",
    "root": "data/external/mnist",
    "normalize": true,
    "normalize_mean": 0.1307,
    "normalize_standard_deviation": 0.3081,
    "normalize_scale": 0.3
  },
  "layer_shapes": [[2, 28, 28], [100], [20]],
  "non_linearity": "double_diode_exponential",
  "weight_gains": [1.0, 1.0],
  "weight_min": 1e-7,
  "weight_max": 100.0,
  "weight_init_mode": "kaiming_uniform",
  "input_gain": 50.0,
  "voltage_amp": 1.0,
  "current_amp": 1.0,
  "quadratic_diode_param": {"diode_conductance": 10.0, "v_min": -1.0, "v_max": 1.0},
  "exponential_diode_param": {"I_s": 1e-6, "V_t": 0.05, "V_off": 1.0},
  "hard_sigmoid_param": {"g_on": 10.0, "g_off": 10.0, "v_min": -1.0, "v_max": 1.0},
  "batch_size": 16,
  "num_epochs": 100,
  "num_iterations": 4,
  "learning_rates": [0.15, 0.08, 0.05],
  "scheduler_gamma": 0.99,
  "nudging": 0.05,
  "ep_variant": "centered",
  "minimizer_impl": "custom",
  "mode": "asynchronous",
  "single_diode_updater": "custom",
  "double_diode_updater": "float64",
  "overrelaxation_factor": 1.1,
  "adaptive_equilibrium": false,
  "rel_tol": 1e-5,
  "vn_tol": 1e-6,
  "use_polish": false,
  "max_newton_iters": 32,
  "z_thresh": 1e10,
  "exp_clip": 165.0,
  "damping": 0.5,
  "experimental_newton_max_steps": 100,
  "experimental_newton_tol": 1e-5,
  "seed": 0,
  "expected_results": {
    "selected_run_count": 4,
    "final_mean_test_accuracy_percent": 97.02000004053116,
    "best_mean_test_accuracy_percent": 97.0725000500679,
    "final_test_accuracy_range_percent": [96.88000011444092, 97.23000001907349],
    "reported_runtime": "roughly 3.5 hours per 100-epoch run on the original host",
    "note": "The four original runs did not record seeds; seed 0 is the standalone canonical rerun seed."
  }
}
