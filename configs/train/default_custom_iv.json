      "maximize": false,
      "method": "sgd",
      "momentum": 0.0,
      "nesterov": false,
      "weight_decay": 0.0,
      "zero_grad_set_to_none": true
    },
    "scheduler": {
      "gamma": 1.0,
      "initial_epoch": -1,
      "method": "exponential",
      "step_timing": "after_epoch"
    }
  }
