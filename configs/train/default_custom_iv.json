{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/schema/training-v2.schema.json",
  "data": {
    "preprocessing": {
      "divisor": 16.0,
      "dtype": "float32",
      "method": "affine",
      "multiplier": 2.0,
      "offset": -1.0
    },
    "seed": 0,
    "source": "sklearn_digits",
    "split": {
      "method": "seeded_random",
      "rounding": "floor",
      "train_fraction": 0.8
    },
    "subset": {
      "method": "all"
    }
  },
  "description": "Editable Digits starter configuration for a sampled custom I-V curve.",
  "equilibrium": {
    "initial_state": "zeros",
    "method": "fixed_sweeps",
    "sweeps": 4,
    "update_order": "asynchronous"
  },
  "execution_ref": {
    "path": "configs/execution/reference_cpu.json",
    "sha256": "59a17593f198295732c9c675b6437f7536abc4bff7a08705e01dda7162459bc1"
  },
  "kind": "training",
  "model": {
    "amplification_learning": {
      "current_factor": false,
      "input_gain": false,
      "voltage_factor": false
    },
    "bias": {
      "bounds": {
        "maximum": null,
        "minimum": 0.0
      },
      "enabled": true,
      "initialization": {
        "method": "constant",
        "value": 0.0
      },
      "interaction": "linear",
      "scale_mode": "legacy"
    },
    "input_encoding": "signed_pair",
    "input_gain": 10.0,
    "layer_shapes": [
      [
        128
      ],
      [
        32
      ],
      [
        20
      ]
    ],
    "loss": {
      "method": "squared_error",
      "reduction": "mean"
    },
    "output": {
      "classes": 10,
      "encoding": "differential_pair"
    },
    "signed_weights": false,
    "state_dtype": "float32",
    "topology": "dense",
    "weight_bounds": {
      "maximum": 100.0,
      "minimum": 1e-07
    },
    "weight_gains": [
      1.0,
      1.0
    ],
    "weight_initialization": "kaiming_uniform"
  },
  "provenance": {
    "materialized_defaults": [
      "data.preprocessing.divisor",
      "data.preprocessing.dtype",
      "data.preprocessing.method",
      "data.preprocessing.multiplier",
      "data.preprocessing.offset",
      "data.split.method",
      "data.split.rounding",
      "data.subset.method",
      "equilibrium.initial_state",
      "model.amplification_learning",
      "model.bias.bounds",
      "model.bias.enabled",
      "model.bias.initialization",
      "model.bias.interaction",
      "model.bias.scale_mode",
      "model.input_encoding",
      "model.loss",
      "model.output",
      "model.signed_weights",
      "model.state_dtype",
      "model.topology",
      "training.batch_limits",
      "training.checkpoint",
      "training.equilibrium_propagation.gradient_formula",
      "training.equilibrium_propagation.nudging_mode",
      "training.loader.drop_last",
      "training.loader.evaluation_shuffle",
      "training.loader.train_shuffle",
      "training.optimizer.dampening",
      "training.optimizer.differentiable",
      "training.optimizer.foreach",
      "training.optimizer.fused",
      "training.optimizer.maximize",
      "training.optimizer.method",
      "training.optimizer.momentum",
      "training.optimizer.nesterov",
      "training.optimizer.weight_decay",
      "training.optimizer.zero_grad_set_to_none",
      "training.scheduler.initial_epoch",
      "training.scheduler.method",
      "training.scheduler.step_timing"
    ],
    "migration": {
      "from_schema_version": 1,
      "to_schema_version": 2,
      "tool": "scripts/migrate_training_configs.py"
    },
    "source": "Derived from the validated Digits measured/PWL anchor; select a different hashed simulator profile to use another curve."
  },
  "schema_version": 2,
  "simulation_ref": {
    "path": "configs/simulator/default_pwl.json",
    "sha256": "c4cf1d5a67a51fbc10e4a9527692b7dada9073622d043e0af2768e5f88372612"
  },
  "training": {
    "batch_limits": {
      "evaluation": null,
      "train": null
