{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/train/schema.json",
  "description": "Editable MNIST starter configuration for double-Shockley training.",
  "source": "Uses the paper MNIST training choices with batch size 10 and a separately editable simulator profile; this starter is not a new paper result.",
  "dataset": {
    "name": "mnist",
    "root": "data/external/mnist",
    "normalize": true,
    "normalize_mean": 0.1307,
    "normalize_standard_deviation": 0.3081,
    "normalize_scale": 0.3
  },
  "layer_shapes": [[2, 28, 28], [100], [20]],
  "simulator_profile": "configs/simulator/default_mnist_double_shockley.json",
  "weight_gains": [1.0, 1.0],
  "weight_min": 1e-7,
  "weight_max": 100.0,
  "weight_init_mode": "kaiming_uniform",
  "input_gain": 50.0,
  "batch_size": 10,
  "num_epochs": 100,
  "num_iterations": 4,
  "learning_rates": [0.15, 0.08, 0.05],
  "scheduler_gamma": 0.99,
  "nudging": 0.05,
  "ep_variant": "centered",
  "seed": 0
}
