{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/train/schema.json",
  "description": "Editable MNIST starter configuration for single-Shockley training.",
  "source": "Uses the validated Digits single-Shockley training choices with MNIST preprocessing and a 100-node hidden layer; this starter is not a new paper result.",
  "dataset": {
    "name": "mnist",
    "root": "data/external/mnist",
    "normalize": true,
    "normalize_mean": 0.1307,
    "normalize_standard_deviation": 0.3081,
    "normalize_scale": 0.3
  },
  "layer_shapes": [[2, 28, 28], [100], [10]],
  "simulator_profile": "configs/simulator/default_single_shockley.json",
  "weight_gains": [1.0, 1.0],
  "weight_min": 1e-7,
  "weight_max": 100.0,
  "weight_init_mode": "kaiming_uniform",
  "input_gain": 10.0,
  "batch_size": 10,
  "num_epochs": 15,
  "num_iterations": 4,
  "learning_rates": [0.005, 0.005, 0.0],
  "scheduler_gamma": 1.0,
  "nudging": 1.0,
  "ep_variant": "centered",
  "seed": 0
}
