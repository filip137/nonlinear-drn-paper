{
  "$schema": "https://raw.githubusercontent.com/filip137/nonlinear-drn-paper/main/configs/train/schema.json",
  "description": "Editable Digits starter configuration for double-Shockley training.",
  "source": "Derived from the validated Digits double-Shockley anchor; this starter is not a new paper result.",
  "dataset": {
    "name": "digits",
    "num_samples": null,
